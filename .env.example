# Optional: override admin panel URL (defaults to localhost:3000 locally,
# https://maison-aurum-admin-panel.vercel.app in production)
# VITE_ADMIN_PANEL_URL=https://maison-aurum-admin-panel.vercel.app

# Optional: protect admin write API
# CATALOG_ADMIN_KEY=

# Optional: extra CORS origins for admin (comma-separated)
# ADMIN_ORIGIN=http://localhost:3000

# Gmail SMTP for account emails (welcome / login alert / password reset)
# Use a Gmail App Password (not your normal password)
SMTP_USER=leotechsaoworld@gmail.com
SMTP_PASS=
SMTP_FROM=LEO GROUP <leotechsaoworld@gmail.com>
SITE_URL=https://maison-aurum.vercel.app

# Stripe Checkout (prefer Test mode keys while developing)
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Webhook signing secret from Dashboard or `stripe listen --forward-to ...`
STRIPE_WEBHOOK_SECRET=whsec_...

# Aiven MySQL (SSL required)
# Copy Service URI from Aiven Console → your MySQL service → Overview
DATABASE_URL=mysql://USER:PASSWORD@HOST:PORT/defaultdb?ssl-mode=REQUIRED
MYSQL_HOST=mysql-xxxxx.l.aivencloud.com
MYSQL_PORT=24556
MYSQL_USER=avnadmin
MYSQL_PASSWORD=
MYSQL_DATABASE=defaultdb
MYSQL_SSL=REQUIRED
